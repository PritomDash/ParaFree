{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/process.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/([a-z0-9][a-z0-9-]*)$",
      "headers": { "Location": "/$1.html" },
      "status": 301
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
