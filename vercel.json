{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/process.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/lib/pdf-tools/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/studypack(?:\\.html)?/?$",
      "headers": { "Location": "/flashcard-quiz-maker.html" },
      "status": 301
    },
    {
      "src": "/([a-z0-9][a-z0-9-]*)$",
      "headers": { "Location": "/$1.html" },
      "status": 301
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
